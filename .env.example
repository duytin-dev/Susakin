# Copy thành .env khi chạy local kết nối Render PostgreSQL
# KHÔNG commit file .env lên GitHub

# --- Render PostgreSQL (External - chạy từ máy local) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-c8jt1h8g4nts73cov6c0-a.oregon-postgres.render.com:5432/susakin_db?sslmode=require
# Hoặc chỉ cần DATABASE_URL nếu deploy trên Render (app tự convert)
# DATABASE_URL=postgresql://susakin_db_user:PASSWORD@dpg-c8jt1h8g4nts73cov6c0-a.oregon-postgres.render.com/susakin_db
SPRING_DATASOURCE_USERNAME=susakin_db_user
SPRING_DATASOURCE_PASSWORD=your_password_from_render_dashboard

# --- Render PostgreSQL (Internal - chỉ dùng khi backend cũng deploy trên Render) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-c8jt1h8g4nts73cov6c0-a:5432/susakin_db
# SPRING_DATASOURCE_USERNAME=susakin_db_user
# SPRING_DATASOURCE_PASSWORD=your_password_from_render_dashboard

SPRING_DDL_AUTO=update
APP_SEED_ENABLED=true
JWT_SECRET=generate_a_new_base64_secret_for_production
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.onrender.com,https://*.vercel.app
PORT=8080
